{
  "expo": {
    "name": "rent-well-mobile",
    "slug": "rent-well-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/pixel-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1726",
        "foregroundImage": "./assets/pixel-adaptive-foreground.png",
        "backgroundImage": "./assets/pixel-adaptive-background.png",
        "monochromeImage": "./assets/pixel-adaptive-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/pixel-favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/pixel-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0E1726"
        }
      ]
    ],
    "backgroundColor": "#0E1726"
  }
}
