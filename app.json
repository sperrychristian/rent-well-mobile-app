{
  "expo": {
    "name": "rent-well-mobile",
    "slug": "rent-well-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/hearth-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EC",
        "foregroundImage": "./assets/hearth-adaptive-foreground.png",
        "backgroundImage": "./assets/hearth-adaptive-background.png",
        "monochromeImage": "./assets/hearth-adaptive-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/hearth-favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/hearth-splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F7F3EC",
          "dark": {
            "image": "./assets/hearth-splash.png",
            "backgroundColor": "#1B1814"
          }
        }
      ]
    ],
    "backgroundColor": "#F7F3EC"
  }
}
