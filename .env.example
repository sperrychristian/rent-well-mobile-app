# Copy this file to .env (which git ignores) and fill in your own Firebase project.
# Firebase console > Build > Realtime Database > Data tab: the address at the top, with no slash at the end.
EXPO_PUBLIC_FIREBASE_DB_URL=https://your-project-default-rtdb.firebaseio.com

# Firebase console > Project settings > General > Web API key.
# Sign up, log in, and the token refresh all need it (Authentication > Sign-in method > Email/Password on).
EXPO_PUBLIC_FIREBASE_API_KEY=your-web-api-key

# Optional: only for the local fake (npm run firebase:fake), leave these out for the real Firebase.
# EXPO_PUBLIC_FIREBASE_AUTH_URL=http://localhost:9000
# EXPO_PUBLIC_FIREBASE_TOKEN_URL=http://localhost:9000

# Only the seed script reads this (npm run firebase:seed), it's the password every seeded account gets.
# Pick your own, 8 characters or more. The app never reads it.
SEED_ACCOUNT_PASSWORD=
