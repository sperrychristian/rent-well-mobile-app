# Copy this file to .env (which git ignores) and fill in your own Firebase project.
# Firebase console > Build > Realtime Database > Data tab: the address at the top, with no slash at the end.
EXPO_PUBLIC_FIREBASE_DB_URL=https://your-project-default-rtdb.firebaseio.com

# Firebase console > Project settings > General > Web API key.
# Optional for now, it's saved for next milestone's Firebase Auth and nothing reads it yet.
EXPO_PUBLIC_FIREBASE_API_KEY=
